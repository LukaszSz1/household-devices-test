<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet id="0003-add-device_brand-table.xml" author="lszwedo" logicalFilePath="changelog/changeset/0003-add-device_brand-table.xml">
        <sql>
            CREATE TABLE device_brand (
                code   VARCHAR(5)   NOT NULL,
                title  VARCHAR(100) NOT NULL,
                active BOOLEAN      NOT NULL,

                CONSTRAINT pk_device_brand_code PRIMARY KEY (code)
            );
        </sql>
    </changeSet>

</databaseChangeLog>